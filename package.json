    "eslint-plugin-playwright": "1.7.0",
    "eslint-plugin-regexp": "2.6.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-tailwindcss": "3.17.5",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "^3.4.14",
